{
    "name": "smtpfast/smtpfast-php",
    "description": "The official PHP SDK for the SMTPfast API.",
    "type": "library",
    "license": "MIT",
    "keywords": ["smtpfast", "email", "transactional-email", "api", "sdk"],
    "homepage": "https://smtpfa.st",
    "support": {
        "docs": "https://smtpfa.st/docs",
        "issues": "https://github.com/smtpfast/smtpfast-php/issues",
        "source": "https://github.com/smtpfast/smtpfast-php"
    },
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "SMTPfast\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SMTPfast\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan"
    }
}
